generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  RH
  TUTOR
  CANDIDATE
}

enum InternshipType {
  ACADEMIC
  PROFESSIONAL
}

enum RequestStatus {
  PENDING
  PROCESS
  ACCEPTED
  REJECTED
}

enum Department {
  DEVELOPMENT
  DESIGN
  MARKETING
  NETWORK
  DATA
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(RH)
  createdAt DateTime @default(now())

  /// Date de validation de l'adresse email. Un compte CANDIDATE non vérifié ne
  /// peut ni se connecter ni consulter de dossier : sans cette preuve, n'importe
  /// qui pourrait s'inscrire avec l'email d'un candidat et lire son dossier.
  /// Les comptes du back-office sont provisionnés par un administrateur, donc
  /// vérifiés d'office.
  emailVerifiedAt DateTime?

  /// SHA-256 du jeton de vérification (jamais le jeton en clair : une fuite de
  /// la base ne doit pas permettre de valider un compte).
  verificationTokenHash      String?   @unique
  verificationTokenExpiresAt DateTime?

  evaluations     RequestEvaluation[]
  tutoredRequests InternshipRequest[] @relation("TutorAssignments")
}

model InternshipOffer {
  id              String         @id @default(cuid())
  title           String
  description     String
  department      Department
  type            InternshipType
  durationMonths  Int
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())

  requests InternshipRequest[]
}

model InternshipRequest {
  id             String         @id @default(cuid())
  trackingCode   String         @unique
  type           InternshipType
  status         RequestStatus  @default(PENDING)
  duration       String
  startDate      DateTime
  reportRequired Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String     @unique
  documents  Document[]
  evaluation RequestEvaluation?

  tutor   User?   @relation("TutorAssignments", fields: [tutorId], references: [id], onDelete: SetNull)
  tutorId String?

  offer   InternshipOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerId String?
}

model Profile {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String

  lieudit   String
  latitude  Float
  longitude Float

  relativePhone1 String
  relativePhone2 String

  school String
  field  String
  level  String

  request InternshipRequest?
}

model Document {
  id    String @id @default(cuid())
  label String
  /// URL signée générée à l'upload — conservée pour les dossiers antérieurs
  /// au stockage du chemin. Les lectures passent par /api/documents/[id].
  url   String
  /// Chemin du fichier dans le bucket Supabase : permet de re-signer une URL
  /// de lecture à la demande, sans dépendre de l'expiration de `url`.
  storagePath String?
  createdAt   DateTime @default(now())

  request   InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model RequestEvaluation {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request   InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String            @unique

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
}

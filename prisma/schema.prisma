generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  RH
  TUTOR
  CANDIDATE
}

enum InternshipType {
  ACADEMIC
  PROFESSIONAL
}

enum RequestStatus {
  PENDING
  PROCESS
  ACCEPTED
  REJECTED
}

enum Department {
  DEVELOPMENT
  DESIGN
  MARKETING
  NETWORK
  DATA
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(RH)
  createdAt DateTime @default(now())

  evaluations     RequestEvaluation[]
  tutoredRequests InternshipRequest[] @relation("TutorAssignments")
}

model InternshipOffer {
  id              String         @id @default(cuid())
  title           String
  description     String
  department      Department
  type            InternshipType
  durationMonths  Int
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())

  requests InternshipRequest[]
}

model InternshipRequest {
  id             String         @id @default(cuid())
  trackingCode   String         @unique
  type           InternshipType
  status         RequestStatus  @default(PENDING)
  duration       String
  startDate      DateTime
  reportRequired Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String     @unique
  documents  Document[]
  evaluation RequestEvaluation?

  tutor   User?   @relation("TutorAssignments", fields: [tutorId], references: [id], onDelete: SetNull)
  tutorId String?

  offer   InternshipOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerId String?
}

model Profile {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String

  lieudit   String
  latitude  Float
  longitude Float

  relativePhone1 String
  relativePhone2 String

  school String
  field  String
  level  String

  request InternshipRequest?
}

model Document {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  request   InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model RequestEvaluation {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request   InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String            @unique

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
}

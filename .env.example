# ------------------------------------------------------------------
# Variables d'environnement — Bridge (gestion des demandes de stage)
# Copier ce fichier en `.env` et renseigner les vraies valeurs.
# NE JAMAIS committer le fichier `.env` (déjà ignoré par git).
# ------------------------------------------------------------------

# --- Base de données PostgreSQL (Prisma) ---
# Avec Supabase, deux URLs (bouton "Connect" du dashboard) :
#  - DATABASE_URL : pooler "Transaction" (port 6543) + ?pgbouncer=true  -> l'app
#  - DIRECT_URL   : pooler "Session" (port 5432)                        -> les migrations
DATABASE_URL="postgresql://postgres.[REF]:[MOT_DE_PASSE]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[MOT_DE_PASSE]@aws-0-[region].pooler.supabase.com:5432/postgres"
# En local (Postgres/Docker), mets la MÊME valeur dans les deux, ex. :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bridge?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bridge?schema=public"

# --- NextAuth (Auth.js) ---
# Générer un secret : `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me-en-un-secret-aleatoire"
# URL de base de l'app (en prod : l'URL Vercel)
AUTH_URL="http://localhost:3000"

# --- Supabase Storage (documents des candidats) ---
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role-supabase"
SUPABASE_STORAGE_BUCKET="documents"

# --- Email : Resend (recommandé) ---
# Dès que RESEND_API_KEY est défini, les emails partent par Resend et les
# variables SMTP ci-dessous sont ignorées. MAIL_FROM doit utiliser un domaine
# vérifié dans Resend : ici le sous-domaine notify.bridgetech-solutions.com.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="Bridge Stages <stages@notify.bridgetech-solutions.com>"

# --- Email : SMTP (solution de secours, utilisée si RESEND_API_KEY est absent) ---
# Microsoft désactive par défaut l'envoi SMTP par mot de passe à partir de
# décembre 2026 (MC786329) : à n'utiliser que de façon transitoire.
# Ex. Office365 : host smtp.office365.com, port 587, secure=false (STARTTLS).
# SMTP_FROM doit correspondre au compte SMTP authentifié (SMTP_USER).
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="compte@votre-domaine.com"
SMTP_PASS="mot-de-passe-ou-cle-application"
SMTP_FROM="compte@votre-domaine.com"

# Secret pour le cron de purge RGPD (Authorization: Bearer …)
# Un .env ne planifie rien : il faut programmer l'appel quotidien côté hébergeur.
#   Vercel    : automatique via vercel.json (0 3 * * *), CRON_SECRET en variable d'environnement.
#   Hostinger : Cron Jobs du panneau, 0 3 * * *, commande :
#     curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://VOTRE-DOMAINE/api/cron/purge-rejected
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me-cron-secret"

# --- Attestation de stage ---
# Le document est signé « La Direction. » (mention fixe, sans nom).
# La signature et le cachet se televersent depuis Admin > Parametres.
ATTESTATION_CITY="Douala"
